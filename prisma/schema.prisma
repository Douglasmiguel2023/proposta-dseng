// DSENG Propostas - schema executavel.
// PRODUCAO: provider "postgresql" (Neon, na Vercel) - e assim que este
// arquivo vai commitado; a DATABASE_URL de producao e a string do Neon.
// DEV LOCAL com SQLite: troque TEMPORARIAMENTE o provider para "sqlite" e
// a DATABASE_URL para "file:./dev.db" (sem commitar essa troca). Os modelos
// nao mudam: valores sao centavos (Int) e textos sao String nos dois bancos.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Proposal {
  id                 String    @id @default(cuid())
  // Slug publico nao adivinhavel (nanoid, 14 caracteres). A proposta de
  // demonstracao usa o slug fixo "exemplo".
  slug               String    @unique
  clienteNome        String
  empresa            String
  clienteWhatsapp    String?
  projetoNome        String
  projetoResumo      String
  // Dinheiro sempre em centavos para nunca ter erro de arredondamento.
  valorVistaCentavos Int
  valorParceladoCentavos Int
  parcelasCartao     Int       @default(3)
  validade           DateTime
  status             String    @default("rascunho") // rascunho | publicada
  views              Int       @default(0)
  firstViewAt        DateTime?
  lastViewAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
}
