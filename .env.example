# =============================================================================
# DSENG Propostas - variaveis de ambiente (copie para .env.local no seu PC
# ou cadastre no painel da Vercel em producao). NUNCA compartilhe os valores.
# =============================================================================

# Banco de dados.
# Local: SQLite, nao precisa instalar nada.
DATABASE_URL="file:./dev.db"
# Producao (Neon/PostgreSQL): a Vercel preenche com a string do Neon quando
# voce cria o banco na aba Storage, mais ou menos assim:
# DATABASE_URL="postgresql://usuario:senha@host.neon.tech/banco?sslmode=require"

# Segredo que assina o cookie de sessao do admin. Inventa um texto longo e
# aleatorio (30+ caracteres) e guarda so para voce.
AUTH_SECRET="troque-por-um-texto-longo-e-aleatorio"

# E-mail do admin (e o seu login no /admin).
ADMIN_EMAIL="voce@seudominio.com.br"

# Senha do admin: escolha UMA das duas opcoes abaixo.
#
# OPCAO A - senha em texto puro (a mais simples, pensada para cadastrar
# direto no painel de variaveis da Vercel, sem gerar hash):
# defina ADMIN_PASSWORD com uma senha LONGA (20 caracteres ou mais, misturando
# letras e numeros). Ela fica somente no servidor, nunca aparece no navegador.
#ADMIN_PASSWORD="uma-senha-bem-longa-e-so-sua"
#
# OPCAO B - hash da senha (mais protegido): gere com
#   npm run hash -- "sua-senha"
# e cole o resultado aqui. Se ADMIN_PASSWORD_HASH existir, ele tem
# prioridade e a OPCAO A e ignorada.
#ADMIN_PASSWORD_HASH="$2a$12$cole-o-hash-gerado-aqui"

# Endereco publico do site (usado nos links e redirecionamentos).
# Local: http://localhost:3000
# Producao: o endereco da Vercel, ex.: https://proposta-dseng.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
